DATABASE_URL=postgresql://deckeval:deckeval@localhost:5432/deckeval
PORT=4000
WEB_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string
# Set to false to make the app invite-only (no public sign-up page)
ALLOW_SIGNUP=true
COOKIE_SECURE=false

# SMTP for magic links. Leave EMAIL_SERVER empty in dev to print links to the API console.
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=Deck Eval <no-reply@deckeval.local>

# Storage: "s3" (Cloudflare R2, MinIO, Supabase S3) or "local" (disk, for dev)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=deck-eval

# AI task intake (optional). Without a key, Smart import still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

SEED_ADMIN_EMAIL=admin@deckeval.local
SEED_ADMIN_PASSWORD=admin12345
SEED_USER_PASSWORD=password123
